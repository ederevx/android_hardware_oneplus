cc_binary {
    name: "vendor.lineage.slider-service.oneplus",
    init_rc: ["vendor.lineage.slider-service.oneplus.rc"],
    vintf_fragments: ["vendor.lineage.slider-service.oneplus.xml"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "AlertSlider.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "vendor.lineage.slider-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
