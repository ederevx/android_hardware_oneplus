android_app {
    name: "OnePlusDiracGef",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    // Only the two widgets and the theme the screen uses. Depending on the
    // SettingsLib aggregate instead merged its whole resource set and classes,
    // which inflated this app to 12 MB for a single switch.
    static_libs: [
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibMainSwitchPreference",
        "SettingsLibSettingsTheme",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
