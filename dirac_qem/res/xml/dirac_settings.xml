<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="dirac_enable"
        android:title="@string/dirac_enable_title"
        android:summary="@string/dirac_enable_summary"
        android:persistent="false" />

    <!-- Added only when the build ships the dirac_biquad effect; the fragment
         removes this row when config_dirac_biquad_fallback_available is false.
         It sits in the same grouped card as the headset model and preset. -->
    <androidx.preference.SwitchPreferenceCompat
        android:key="dirac_biquad_fallback"
        android:title="@string/dirac_biquad_fallback_title"
        android:summary="@string/dirac_biquad_fallback_summary"
        android:widgetLayout="@layout/preference_widget_switch_compat"
        android:persistent="false" />

    <ListPreference
        android:key="dirac_model"
        android:title="@string/dirac_model_title"
        android:summary="%s"
        android:entries="@array/dirac_model_entries"
        android:entryValues="@array/dirac_model_values"
        android:persistent="false" />

    <ListPreference
        android:key="dirac_style"
        android:title="@string/dirac_style_title"
        android:summary="%s"
        android:entries="@array/dirac_style_entries"
        android:entryValues="@array/dirac_style_values"
        android:persistent="false" />

    <PreferenceCategory android:title="@string/dirac_eq_title">

        <org.lineageos.dirac.qem.EqPreviewPreference
            android:key="dirac_eq_preview" />

        <org.lineageos.dirac.qem.EqBoardPreference
            android:key="dirac_eq_board" />
    </PreferenceCategory>

    <!-- A group divider, so the expressive adapter closes the equalizer card
         here and the width row renders as its own card instead of as the last
         row of the equalizer card. -->
    <com.android.settingslib.widget.SpacePreference
        android:layout_height="16dp" />

    <!-- Drives the ADSP panorama2 Sum/Diff balance on every supported route
         (speaker, wired headset) and the host StereoWidth state where the
         fallback runs; it needs neither the fallback build flag nor the
         fallback switch to be present or enabled. -->
    <org.lineageos.dirac.qem.SumDiffPreference
        android:key="dirac_sumdiff" />

    <!-- DEV PROBE: the same width state with the range widened past the limit
         the layers below enforce and without the route gate, so a sweep above
         1.0 is possible on any sink. The fragment removes this row unless
         config_dirac_sumdiff_probe is true. -->
    <org.lineageos.dirac.qem.SumDiffProbePreference
        android:key="dirac_sumdiff_probe" />
</PreferenceScreen>
