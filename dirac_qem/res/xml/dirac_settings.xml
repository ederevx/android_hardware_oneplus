<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="dirac_enable"
        android:title="@string/dirac_enable_title"
        android:summary="@string/dirac_enable_summary"
        android:persistent="false" />

    <ListPreference
        android:key="dirac_model"
        android:title="@string/dirac_model_title"
        android:entries="@array/dirac_model_entries"
        android:entryValues="@array/dirac_model_values"
        android:persistent="false" />

    <ListPreference
        android:key="dirac_style"
        android:title="@string/dirac_style_title"
        android:entries="@array/dirac_style_entries"
        android:entryValues="@array/dirac_style_values"
        android:persistent="false" />

    <PreferenceCategory android:title="@string/dirac_eq_title" />

    <SeekBarPreference
        android:key="dirac_eq_0"
        android:title="68 Hz"
        android:persistent="false" />
    <SeekBarPreference
        android:key="dirac_eq_1"
        android:title="165 Hz"
        android:persistent="false" />
    <SeekBarPreference
        android:key="dirac_eq_2"
        android:title="400 Hz"
        android:persistent="false" />
    <SeekBarPreference
        android:key="dirac_eq_3"
        android:title="972 Hz"
        android:persistent="false" />
    <SeekBarPreference
        android:key="dirac_eq_4"
        android:title="2 kHz"
        android:persistent="false" />
    <SeekBarPreference
        android:key="dirac_eq_5"
        android:title="6 kHz"
        android:persistent="false" />
    <SeekBarPreference
        android:key="dirac_eq_6"
        android:title="14 kHz"
        android:persistent="false" />
</PreferenceScreen>
