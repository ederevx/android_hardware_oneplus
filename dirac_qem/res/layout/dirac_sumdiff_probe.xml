<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- The card's vertical inset sits on this container rather than on the root:
         the root's own paddingTop/paddingBottom is not what the rendered card
         shows, so the inset has to be carried here. 16dp is the inset measured
         on the equalizer card, 42 px above and below its content, and what the
         width card was missing (its rows were flush with the card edge). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/dirac_sumdiff_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:textSize="12sp" />

        <org.lineageos.dirac.qem.SumDiffProbeSlider
            android:id="@+id/dirac_sumdiff_slider"
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- The title row is exactly as tall as the reset button, so the title sits
             the same distance below the bar as the magnitude sits above it: the
             value's bottom padding and the title's share of this row are both 6dp
             past the slider's own half-height. The row carries the inset the
             equalizer's band labels have, so the title and the reset read at the same
             distance from the card border as those labels do: 16dp of leading inset,
             and enough trailing inset to keep the reset's ink off the border. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dirac_sumdiff_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:text="@string/dirac_sumdiff_title"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/dirac_sumdiff_reset"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dirac_sumdiff_reset"
                android:scaleType="centerInside"
                android:src="@drawable/ic_reset" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
