android_app {
    name: "OnePlusDiracQem",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    // This app owns the on-device Dirac equalizer, so it replaces AudioFX.
    overrides: ["AudioFX"],

    // Only the widgets and the theme the screen uses.
    static_libs: [
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibMainSwitchPreference",
        "SettingsLibSettingsTheme",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
